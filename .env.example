# 팀이 운영하는 Ollama 서버(우선 사용). https 주소만 허용해요.
CHAT_BASE_URL=https://your-computer.your-tailnet.ts.net
CHAT_MODEL=gemma3:12b
# 서버 앞에 토큰 확인 프록시를 둘 때만 적어요(Authorization: Bearer 로 전달).
CHAT_API_KEY=

# 선택: 팀 서버가 없을 때 OpenAI를 쓰려면
# Optional server-only settings. The app works in example mode without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
